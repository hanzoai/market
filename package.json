    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.87.0",
    "react-native-web": "^0.21.2",
    "react-router": "^8.3.1"
  },
  "devDependencies": {
    "@hanzo/design": "0.5.24",
    "@hanzo/vite": "0.1.4",
    "@playwright/test": "^1.58.1",
